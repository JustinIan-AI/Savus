/scripts/_fetch_clawhub_skills.py
.worktrees/
.agents

# Project-scoped agent skills are versioned in-tree when needed.
!.agents/skills/

# SquillaRouter V4 Phase 3 权重二进制（74.5MB）不进版本库：体积大且非产品公开面
# （squilla_router 在模块审计中为 Cancel 模块）。保留在同一 bundle 内的运行时源码与
# 配置（runtime_src/、router.runtime.yaml、artifact_manifest.json 等，约 700KB），
# 缺失的权重按 artifact_manifest.json 记录的 sha256 校验后放回同名路径即可恢复。
# 注意：权重缺失时 router 与本地 embedding 会降级/报错，恢复步骤见 docs。
src/loopdesk/squilla_router/models/**/*.bin
src/loopdesk/squilla_router/models/**/*.onnx
src/loopdesk/squilla_router/models/**/*.pkl
src/loopdesk/squilla_router/models/**/*.joblib

# Design & Preflight generated artifacts
.preflight/
