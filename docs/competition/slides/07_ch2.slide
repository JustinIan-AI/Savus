<Slide style={{ width:'1280px', height:'720px', background:'#FFFFFF', padding:'24px 64px 40px', display:'flex', flexDirection:'column' }}>
  <Box style={{ display:'flex', alignItems:'center', gap:14, height:64 }}>
    <Box style={{ width:8, height:34, background:'#FF6B35', borderRadius:4 }} />
    <Text style={{ fontSize:30, fontWeight:'bold', color:'#1B1F3B', fontFamily:'PingFang SC' }}>分层架构：LoopDesk 作为第四种 Worker Runtime</Text>
  </Box>
  <Box style={{ display:'flex', gap:18, marginTop:6 }}>
    <Box style={{ width:724, display:'flex', flexDirection:'column', gap:9 }}>
      {[
        { n:'用户入口', d:'Issue / 错误日志 / 工单 / 用户反馈', bg:'#E9EEFB', tc:'#1B1F3B', dc:'#2A2F5B' },
        { n:'AgentTeams 编排平面', d:'声明式 CRD · Matrix 审计时间线 · Higress 凭证隔离 · MinIO 共享存储', bg:'#2A2F5B', tc:'#FFFFFF', dc:'#C7CCE0' },
        { n:'Worker Runtime 层 · spec.runtime 可插拔', d:'OpenClaw · QwenPaw · Hermes · ▶ LoopDesk（本方案新增）', bg:'#1B1F3B', tc:'#FFFFFF', dc:'#FFB499', hl:true },
        { n:'LoopDesk 运行时内核', d:'Loop Engine · 独立 Verifier + Receipt · Skill 62+7 · 证据链 · 安全层 · Rollback', bg:'#FFEDE4', tc:'#5A3320', dc:'#8A4A2A', core:true },
        { n:'工具连接层', d:'MCP Client/Server（双向已实现）+ 阿里云官方用云 Skills（零适配）', bg:'#E9EEFB', tc:'#1B1F3B', dc:'#2A2F5B' },
        { n:'存储', d:'SQLite 状态/记忆 · 向量 embedding · Trace JSONL（均可回放）', bg:'#F1F3F8', tc:'#1B1F3B', dc:'#4A5168' },
      ].map((l, i) => (
        <Box key={i} style={{ height:80, borderRadius:10, padding:'9px 18px', background:l.bg, borderLeft: l.core ? '5px solid #FF6B35' : '5px solid transparent', display:'flex', flexDirection:'column', justifyContent:'center' }}>
          <Text style={{ fontSize:16.5, fontWeight:'bold', color:l.tc, fontFamily:'PingFang SC' }}>{l.n}</Text>
          <Text style={{ fontSize:13.5, color:l.dc, marginTop:4, fontFamily:'PingFang SC' }}>{l.d}</Text>
        </Box>
      ))}
    </Box>
    <Box style={{ width:404, background:'#1B1F3B', borderRadius:12, padding:'20px 22px', display:'flex', flexDirection:'column' }}>
      <Text style={{ fontSize:19, fontWeight:'bold', color:'#FFFFFF', fontFamily:'PingFang SC' }}>关键技术选型与必要性</Text>
      <Box style={{ width:48, height:4, background:'#FF6B35', borderRadius:2, margin:'10px 0 14px' }} />
      {[
        { k:'协同编排', v:'AgentTeams（赛道强制）' },
        { k:'Worker 运行时', v:'LoopDesk 补齐官方不做' },
        { k:'工具连接', v:'MCP（已双向实现）' },
        { k:'官方 Skills', v:'阿里云用云（零适配）' },
        { k:'存储 / 可观测', v:'可替换为 PolarDB / LoongSuite' },
      ].map((r, i) => (
        <Box key={i} style={{ display:'flex', gap:12, padding:'9px 0', borderTop: i===0 ? 'none' : '1px solid #2E3358' }}>
          <Text style={{ fontSize:14, color:'#FF6B35', fontWeight:'bold', width:96, fontFamily:'PingFang SC' }}>{r.k}</Text>
          <Text style={{ fontSize:14.5, color:'#D7DBEA', fontFamily:'PingFang SC' }}>{r.v}</Text>
        </Box>
      ))}
      <Text style={{ fontSize:12.5, color:'#7C83A8', marginTop:'auto', fontFamily:'PingFang SC', lineHeight:1.5 }}>评审不看工具数量，看必要性、接口契约、可替换性与权限边界。</Text>
    </Box>
  </Box>
</Slide>
