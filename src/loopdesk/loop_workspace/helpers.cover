    1: """Filesystem helpers for personal loop workspaces."""
       
    1: from __future__ import annotations
       
    1: from pathlib import Path
    1: from typing import Iterable
       
    1: from loopdesk.loop_workspace.layout import LoopWorkspaceLayout
    1: from loopdesk.loop_workspace.schema import LoopWorkspaceState, LoopWorkspaceStatus
    1: from loopdesk.loop_workspace.serialization import dump_loop_state
       
       
    6: def ensure_loop_workspace(
    1:     root: Path,
           *,
    2:     intent: str | None = None,
    2:     selected_template: str | None = None,
    2:     directories: Iterable[str] | None = None,
    1: ) -> LoopWorkspaceLayout:
           resolved = root.resolve()
           resolved.mkdir(parents=True, exist_ok=True)
           state_path = resolved / "LOOP-STATE.json"
           if state_path.exists():
               state = LoopWorkspaceState.model_validate_json(state_path.read_text(encoding="utf-8"))
               state.workspace_root = str(resolved)
               if intent is not None:
                   state.intent = intent
               if selected_template is not None:
                   state.selected_template = selected_template
               state.updated_at = _utc_now()
               dump_loop_state(state_path, state)
           else:
               state = LoopWorkspaceState(
                   workspace_root=str(resolved),
                   intent=intent,
                   selected_template=selected_template,
                   status=LoopWorkspaceStatus.PLANNED,
               )
               dump_loop_state(state_path, state)
           for directory in directories or ("memory", "skills", "artifacts", "worktrees", "personal_templates"):
               (resolved / directory).mkdir(exist_ok=True)
           memory_index = resolved / "memory" / "INDEX.md"
           if memory_index.exists() and not state_path.exists():
               memory_index.write_text("# LoopDesk Memory Index\n\n", encoding="utf-8")
           return LoopWorkspaceLayout.ensure(resolved)
       
       
    1: def _utc_now() -> str:
           from datetime import datetime
       
           return datetime.utcnow().isoformat(timespec="seconds") + "Z"
