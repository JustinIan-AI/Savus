    1: """Personal workflow templates for LoopDesk."""
       
    1: from __future__ import annotations
       
    1: from dataclasses import dataclass
    1: from typing import List
       
       
    3: @dataclass(frozen=True)
    2: class PersonalWorkflowTemplate:
    1:     id: str
    1:     name: str
    1:     description: str
    1:     loop_steps: List[str]
    1:     goal_steps: List[str]
    1:     roles: List[str]
       
       
    1: PERSONAL_LOOP_TEMPLATES = [
