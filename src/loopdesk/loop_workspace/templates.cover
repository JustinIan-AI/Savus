    1: def list_personal_templates() -> List[PersonalWorkflowTemplate]:
           return list(PERSONAL_LOOP_TEMPLATES)
       
       
    1: def load_personal_template(template_id: str) -> PersonalWorkflowTemplate:
           for template in PERSONAL_LOOP_TEMPLATES:
               if template.id == template_id:
                   return template
           raise KeyError(f"Unknown personal workflow template: {template_id}")
